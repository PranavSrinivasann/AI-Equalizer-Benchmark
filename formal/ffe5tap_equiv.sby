# Unbounded equivalence proofs (k-induction) of each optimized FFE against its
# baseline. Run all:   sby -f formal/ffe5tap_equiv.sby
# Run one:             sby -f formal/ffe5tap_equiv.sby C_ai
#
# A pass means y_out is bit-identical on every cycle for all inputs and
# reset sequences, which also proves any removed saturation logic was
# unreachable for that coefficient set.

[tasks]
# Each task also carries a tag naming its reference (gold) design.
A_ai   gold_A
B_ai   gold_B
C_ai   gold_C
A_hand gold_A
B_hand gold_B
C_hand gold_C

[options]
mode prove
depth 8

[engines]
smtbmc yices

[script]
gold_A: read_verilog -sv ffe5tap_pam4.sv
gold_B: read_verilog -sv ffe5tap_caseB_baseline.sv
gold_C: read_verilog -sv ffe5tap_caseC_baseline.sv
rename ffe5tap_pam4 gold
A_ai:   read_verilog -sv ffe5tap_pam4_claude_resource1.sv
B_ai:   read_verilog -sv ffe5tap_caseB_optimized.sv
C_ai:   read_verilog -sv ffe5tap_caseC_optimized.sv
A_hand: read_verilog -sv ffe5tap_caseA_hand.sv
B_hand: read_verilog -sv ffe5tap_caseB_hand.sv
C_hand: read_verilog -sv ffe5tap_caseC_hand.sv
rename ffe5tap_pam4 gate
read_verilog -sv -formal ffe5tap_equiv.sv
prep -top ffe5tap_equiv

[files]
../rtl/ffe5tap_pam4.sv
../rtl/ffe5tap_pam4_claude_resource1.sv
../rtl/generalization/ffe5tap_caseB_baseline.sv
../rtl/generalization/ffe5tap_caseC_baseline.sv
../rtl/generalization/optimized/ffe5tap_caseB_optimized.sv
../rtl/generalization/optimized/ffe5tap_caseC_optimized.sv
../rtl/hand/ffe5tap_caseA_hand.sv
../rtl/hand/ffe5tap_caseB_hand.sv
../rtl/hand/ffe5tap_caseC_hand.sv
ffe5tap_equiv.sv
